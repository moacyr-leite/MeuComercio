{
  "name": "meucomercio",
  "version": "1.0.0",
  "description": "Sistema simples de controle de estoque e vendas para pequenos mercados e comércios familiares.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "client": "cd client && npm run dev",
    "server": "cd server && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moacyr-leite/MeuComercio.git"
  },
